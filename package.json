{
    "name": "xiuli",
    "productName": "休历",
    "version": "2.2.0",
    "description": "休历 - 管理请假、出勤、工资扣除和节假日火车票购票提醒的本地日历工具",
    "license": "MIT",
    "author": "skywalker23241",
    "main": "desktop/main.js",
    "scripts": {
        "start": "electron .",
        "serve": "node server.js",
        "build:calendar": "node scripts/build-calendar-bundle.js",
        "screenshots": "node scripts/readme-screenshots.cjs",
        "screenshots:hero": "node scripts/hero-screenshots.cjs",
        "verify:structure": "node scripts/verify-structure.js",
        "verify:server": "node scripts/verify-server.js",
        "verify:cache-version": "node scripts/verify-cache-version.js",
        "verify:calendar-data": "node scripts/verify-calendar-data.js",
        "verify:mobile": "electron scripts/verify-mobile.js",
        "verify:overview": "electron scripts/verify-overview-modules.js",
        "verify:calendar": "electron scripts/verify-calendar-integration.js",
        "verify:integrations": "electron scripts/verify-integrations.js",
        "verify:i18n": "electron scripts/verify-i18n.js",
        "test": "node scripts/test-ics.js && node scripts/test-payroll.js && node scripts/test-google-sync.js && node scripts/test-webdav-policy.js",
        "verify": "npm run verify:structure && npm run verify:calendar-data && npm run verify:server && npm test && npm run verify:cache-version",
        "build:android": "node scripts/build-android-web.cjs && cap sync android && cd android && gradlew.bat assembleDebug",
        "dist": "electron-builder --win"
    },
    "devDependencies": {
        "@capacitor/cli": "^6.2.1",
        "astral-regex": "^2.0.0",
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.skywalker23241.xiuli",
        "productName": "休历",
        "directories": {
            "output": "dist"
        },
        "files": [
            "desktop/**",
            "public/**",
            "shared/**",
            "LICENSE"
        ],
        "protocols": [
            {
                "name": "休历日期链接",
                "schemes": [
                    "restcal"
                ]
            }
        ],
        "win": {
            "target": [
                "portable",
                "zip",
                "nsis"
            ],
            "icon": "public/assets/icons/icon-512.png"
        },
        "portable": {
            "artifactName": "休历-${version}-portable.exe"
        },
        "nsis": {
            "artifactName": "休历-${version}-setup.exe",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "electronDownload": {
            "mirror": "https://npmmirror.com/mirrors/electron/"
        }
    },
    "dependencies": {
        "@capacitor/android": "^6.2.1",
        "@capacitor/app": "^6.0.3",
        "@capacitor/core": "^6.2.1",
        "@phosphor-icons/web": "^2.1.2"
    }
}

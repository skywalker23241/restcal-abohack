# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Local editor settings
.vscode/
.idea/

# Local AI assistant state
.agents/
.claude/

# Temporary files
*.tmp
*.temp

# Dependencies, if added later
node_modules/

# Desktop build output
dist/

# Release binaries: distributed as GitHub Release assets only, never committed.
# Each committed release adds tens of MB to every future clone. The checksums
# (releases/SHA256SUMS-*.txt) and notes (releases/RELEASE_NOTES-*.md) stay in Git.
releases/*.apk
releases/*.exe
releases/*.zip

# Visual verification output
scripts/shots/

# Android web assets generated before Capacitor sync
mobile/
.aidesigner/*
!.aidesigner/.gitkeep
